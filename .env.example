# ── Reverse-Proxy / TLS (Caddy) ─────────────────────────────────────────────
# Oeffentliche Domain -> Caddy holt automatisch ein HTTPS-Zertifikat.
# Wird ausschliesslich von Caddy gelesen (Docker-Betrieb);
# im Node-Betrieb ohne Wirkung.
SITE_ADDRESS=secret.example.com
#   Schnelltest ohne TLS:                SITE_ADDRESS=:80
#   Internes Netz ohne oeffentliches DNS: in der Caddyfile auf "tls internal" umstellen

# ── App ─────────────────────────────────────────────────────────────────────
MAX_TTL=604800                 # groesste Lebensdauer eines Geheimnisses in Sekunden (7 Tage)
RATE_LIMIT_PER_MIN=60          # Anfragen pro IP/Minute auf /api/*; darueber HTTP 429

# Die folgenden beiden sind optional - hier stehen die eingebauten Standardwerte.
# ACHTUNG: Der Server zwingt jedes angefragte ttl in den Bereich MIN_TTL..MAX_TTL,
# ohne das zu melden. ttl=60 ergibt also 300 Sekunden. Wer kuerzere Laufzeiten
# braucht, muss MIN_TTL hier senken.
#MIN_TTL=300                   # kleinste Lebensdauer in Sekunden (5 Minuten)
#DEFAULT_TTL=86400             # Lebensdauer, wenn die Anfrage kein ttl enthaelt (1 Tag)

# ── Optionale Server-Encrypt-API (Server verschluesselt; kein Zero-Knowledge) ─
# ACHTUNG: in diesem Modus verschluesselt der SERVER -> kein Zero-Knowledge mehr.
# Nur fuers eigene, vertrauenswuerdige Netz sinnvoll. Standard: aus.
ALLOW_SERVER_ENCRYPT=false
API_TOKEN=                     # langes Zufallstoken; Pflicht wenn ALLOW_SERVER_ENCRYPT=true
BASE_URL=                      # z.B. https://secret.example.com (fuer die zurueckgegebenen Links)
